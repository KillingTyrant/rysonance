# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Credenziali OAuth di Google, lette da supabase/config.toml ([auth.external.google])
# per lo stack Supabase locale. Vanno in un file `.env` nella root del progetto
# (gitignorato). Sul progetto cloud si configurano dalla Dashboard, non da qui.
# Client OAuth "Web application" su https://console.cloud.google.com/auth/clients
# con redirect URI http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-oauth-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-oauth-client-secret
